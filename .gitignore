# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# user uploads (runtime data, not source)
/public/uploads/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
node_modules

#scripts
scripts/upload-hero.ts

# graphify knowledge graph — keep curated community labels, ignore
# regenerable artifacts (the graph itself, AST cache, dated snapshots)
# so `graphify update .` doesn't produce giant diffs. Labels are curated
# work worth versioning; everything else is rebuilt from source.
graphify-out/cache/
graphify-out/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/graph.json
graphify-out/graph.html
graphify-out/manifest.json
graphify-out/cost.json
graphify-out/GRAPH_REPORT.md
graphify-out/.graphify_python
graphify-out/.graphify_root