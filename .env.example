# ─── Database ────────────────────────────────────────────────────────────────
# Aiven PostgreSQL (or any PostgreSQL instance)
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# Local dev: file path to CA cert. Vercel: base64-encoded CA cert (base64 -i ca.pem | tr -d '\n')
DB_SSL_CERT_PATH="/path/to/ca.pem"
DB_SSL_CERT=""

# ─── Auth ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"        # production: https://yourdomain.com
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-strong-password"

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_..."
FROM_EMAIL="invites@yourdomain.com"

# ─── Google Maps ──────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="your-server-side-key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-public-key"

# ─── Cloudflare R2 (image uploads) ────────────────────────────────────────────
R2_ACCOUNT_ID="your-account-id"
R2_BUCKET_NAME="your-bucket-name"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_PUBLIC_URL="https://pub-xxx.r2.dev"

# ─── Optional: Chotu AI assistant ─────────────────────────────────────────────
# Chotu is optional. Without keys, the chat features are disabled.
# Provide either Gemini or Groq keys (or both):
# GEMINI_API_KEY=""
# GROQ_API_KEY=""
# CHOTU_KEYS='{"gemini":"...","groq":"..."}'
